{
  "name": "justapi",
  "displayName": "JustAPI",
  "description": "A local-first API client for VS Code",
  "version": "1.0.1",
  "publisher": "DevBySergio",
  "author": {
    "name": "DevBySergio",
    "url": "https://devbysergio.com/"
  },
  "license": "MIT",
  "homepage": "https://devbysergio.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevBySergio/JustAPI_by_Sergio.git"
  },
  "bugs": {
    "url": "https://github.com/DevBySergio/JustAPI_by_Sergio/issues"
  },
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Testing",
    "Programming Languages"
  ],
  "keywords": [
    "api",
    "rest",
    "http",
    "postman",
    "client"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "justapi-activity",
          "title": "JustAPI",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "justapi-activity": [
        {
          "type": "webview",
          "id": "justapi.sidebar",
          "name": "JustAPI",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "justapi.createRequest",
        "title": "JustAPI: New Request"
      },
      {
        "command": "justapi.importCurl",
        "title": "JustAPI: Import from cURL"
      },
      {
        "command": "justapi.exportCollection",
        "title": "JustAPI: Export Collection"
      },
      {
        "command": "justapi.importCollection",
        "title": "JustAPI: Import Collection"
      },
      {
        "command": "justapi.openHistory",
        "title": "JustAPI: Open History"
      },
      {
        "command": "justapi.createVariable",
        "title": "JustAPI: Create Variable"
      },
      {
        "command": "justapi.generateCode",
        "title": "JustAPI: Generate Code Snippet"
      }
    ],
    "keybindings": [
      {
        "command": "justapi.createRequest",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "justapi.importCurl",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "justapi.createRequest"
        },
        {
          "command": "justapi.importCurl"
        },
        {
          "command": "justapi.exportCollection"
        },
        {
          "command": "justapi.importCollection"
        },
        {
          "command": "justapi.openHistory"
        },
        {
          "command": "justapi.createVariable"
        },
        {
          "command": "justapi.generateCode"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "clean": "node -e \"for (const path of ['out', 'dist', 'coverage']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "compile": "npm run build",
    "build": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "vsix": "vsce package --no-dependencies --allow-missing-repository",
    "publish": "vsce publish --allow-missing-repository",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "typecheck:extension": "tsc -p . --noEmit",
    "typecheck:webview": "tsc -p webview-ui/tsconfig.json --noEmit",
    "lint": "eslint src webview-ui/src --max-warnings 0",
    "test:policy": "node scripts/check-test-policy.mjs",
    "test:unit": "npm run compile-tests && node --test out/test/unit/*.test.js",
    "test:integration": "npm run compile-tests && node --test out/test/integration/*.test.js",
    "pretest:extension": "npm run compile-tests && npm run build",
    "test:extension": "vscode-test",
    "test": "npm run test:policy && npm run test:unit && npm run test:integration && npm run test:extension",
    "audit:runtime": "npm audit --omit=dev --audit-level=low",
    "audit:full": "npm audit --audit-level=low",
    "package:list": "node scripts/check-package.mjs",
    "validate:static": "npm run test:policy && npm run lint && npm run typecheck:extension && npm run typecheck:webview && npm run test:unit && npm run test:integration && npm run build && npm run audit:runtime && npm run audit:full",
    "validate": "npm run validate:static && npm run test:extension && npm run vsix && npm run package:list"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "overrides": {
    "diff": "8.0.3",
    "serialize-javascript": "7.0.5"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "1.80.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.3",
    "sharp": "^0.34.5",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  }
}
